[Unit]
Description=University Hotel RFID Door Controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/university-hotel/rfid-controller
EnvironmentFile=/etc/university-hotel/door-controller.env
ExecStart=/opt/university-hotel/rfid-controller/.venv/bin/python /opt/university-hotel/rfid-controller/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target